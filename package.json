{
  "name": "silverbot-tickets",
  "version": "1.0.0",
  "description": "Advanced Discord Ticket Management Bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist/",
    "rebuild": "npm run clean && npm run build"
  },
  "keywords": [
    "discord",
    "bot",
    "tickets",
    "discord.js"
  ],
  "author": "SilverCore",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.1"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0"
  }
}
